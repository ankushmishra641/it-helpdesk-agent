# Local defaults require no provider account.
DATABASE_URL=sqlite:///helpdesk.db
LLM_PROVIDER=none

# Optional Groq explanations. Enable explicitly after configuring usage limits.
# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DAILY_LLM_LIMIT=100

# On Render use the Supabase Session pooler URI with ?sslmode=require.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
